# Normalize text files and use LF on all platforms
* text=auto

# Python and workflow source code
*.py text eol=lf
*.sh text eol=lf
*.nf text eol=lf
*.groovy text eol=lf

# Docker configuration
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Scientific data and documentation
*.csv text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
